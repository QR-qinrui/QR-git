root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# PS 5.1 三坑：.ps1 必须 UTF-8 with BOM + CRLF
[*.{ps1,psm1}]
charset = utf-8-bom
end_of_line = crlf

# cmd 必须 CRLF，注释只用 ASCII
[*.{bat,cmd}]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false
