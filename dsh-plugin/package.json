{
  "name": "@qr/afo-file-organizer",
  "version": "1.0.0",
  "private": true,
  "description": "AI 资产文件扫描归类与安全迁移（afo Python 核心的 dsh 挂载层）",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.7"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dshx": {
    "contributes": {
      "tools": ["afo_organize"]
    }
  },
  "license": "MIT"
}
